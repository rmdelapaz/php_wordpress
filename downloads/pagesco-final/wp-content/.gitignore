# Pages & Co.: Git keeps the shop's own code, and nothing else.
# Everything in wp-content is ignored, then the shop's folders and files are let back in with "!".
/*
!/.gitignore

!/mu-plugins/
/mu-plugins/*
!/mu-plugins/pagesco-site.php

!/themes/
/themes/*
!/themes/pagesco/

!/plugins/
/plugins/*
!/plugins/pagesco-books/

# Inside the plugin: what Composer, npm and the tools make. A release build makes them again.
/plugins/pagesco-books/vendor/
/plugins/pagesco-books/node_modules/
/plugins/pagesco-books/build/
/plugins/pagesco-books/*.zip
/plugins/pagesco-books/.phpunit.result.cache
