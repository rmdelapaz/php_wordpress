{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pagesco/book-card",
	"version": "0.2.0",
	"title": "Book Card",
	"category": "widgets",
	"icon": "book",
	"description": "A book recommended by the Pages & Co. staff.",
	"keywords": [ "staff pick", "recommendation" ],
	"textdomain": "pagesco-books",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-pagesco-book-card__title"
		},
		"author": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-pagesco-book-card__author"
		},
		"pick": {
			"type": "string",
			"source": "html",
			"selector": ".wp-block-pagesco-book-card__pick"
		},
		"url": {
			"type": "string",
			"source": "attribute",
			"selector": ".wp-block-pagesco-book-card__link",
			"attribute": "href"
		},
		"headingLevel": {
			"type": "integer",
			"default": 3
		},
		"showBadge": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"example": {
		"attributes": {
			"title": "The Hobbit",
			"author": "J.R.R. Tolkien",
			"pick": "The perfect first fantasy novel, at any age."
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
