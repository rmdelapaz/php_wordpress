# The live site's secrets. Copy this file to .env and replace every value with your own:
#   cp .env.example .env
# .env stays on the server only: never commit it, never send it by email or chat.
DB_ROOT_PASSWORD=replace-with-a-long-random-password
DB_APP_PASSWORD=replace-with-another-long-random-password
PAGESCO_BOOKS_SUPPLIER_URL=https://api.riverside.example/v1/
PAGESCO_BOOKS_SUPPLIER_KEY=replace-with-the-live-api-key
