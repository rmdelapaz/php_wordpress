{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "night", "name": "Night", "color": "#1b1f3b" },
				{ "slug": "cream", "name": "Cream", "color": "#fff8e7" },
				{ "slug": "lantern", "name": "Lantern", "color": "#f2b134" }
			]
		},
		"layout": {
			"contentSize": "640px",
			"wideSize": "1040px"
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|cream",
			"text": "var:preset|color|night"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|night" }
			}
		}
	}
}
