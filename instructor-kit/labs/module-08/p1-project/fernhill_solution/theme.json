{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f7f5ee" },
				{ "slug": "contrast", "name": "Contrast", "color": "#23301f" },
				{ "slug": "primary", "name": "Primary", "color": "#3f6b35" },
				{ "slug": "secondary", "name": "Secondary", "color": "#e4ecd9" },
				{ "slug": "accent", "name": "Accent", "color": "#9c4426" }
			]
		},
		"layout": {
			"contentSize": "680px",
			"wideSize": "1100px"
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{ "slug": "serif", "name": "Serif", "fontFamily": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, serif" },
				{ "slug": "sans", "name": "Sans", "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.4rem", "max": "1.75rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.5rem", "fluid": { "min": "1.9rem", "max": "2.5rem" } }
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"padding": {
				"left": "1rem",
				"right": "1rem"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|serif",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" }
			},
			"heading": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|sans",
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "700"
				},
				"elements": {
					"link": { "color": { "text": "var:preset|color|contrast" } }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
