{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pagesco/next-events",
	"version": "0.1.0",
	"title": "Next Events",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "The shop's next events, always up to date.",
	"textdomain": "pagesco-next-events",
	"attributes": {
		"count": {
			"type": "integer"
		},
		"location": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		}
	},
	"render": "file:./render.php"
}
